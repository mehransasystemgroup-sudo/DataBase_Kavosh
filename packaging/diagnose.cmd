@echo off
rem ---------------------------------------------------------------------
rem  اجرای برنامه با پنجره‌ای که بسته نمی‌شود.
rem
rem  چرا لازم است: اگر KavoshDB.exe هنگام بالا آمدن بیفتد، ویندوز پنجرهٔ
rem  کنسولش را همان لحظه می‌بندد و کاربر فقط یک برق کوتاه می‌بیند. این فایل
rem  برنامه را از داخل یک کنسولِ خودش اجرا می‌کند، پس هرچه برنامه بگوید —
rem  حتی خطای بارگذاری کتابخانه، که پیش از رسیدن به کد پایتون رخ می‌دهد و
rem  هیچ گزارشی از آن نمی‌ماند — روی صفحه می‌ماند تا خوانده شود.
rem ---------------------------------------------------------------------
chcp 65001 >nul
title تشخیص مشکل — کاوشگر پایگاه داده

echo.
echo   کاوشگر پایگاه داده — اجرای تشخیصی
echo   ------------------------------------------------------------
echo   مسیر نصب:   %~dp0
echo   پوشهٔ داده:  %LOCALAPPDATA%\KavoshDB
echo.
echo   برنامه در حال اجراست. برای بستن، همین پنجره را ببندید.
echo   اگر برنامه بالا نیامد، متن خطا پایین می‌ماند — عکسش را بفرستید.
echo   ------------------------------------------------------------
echo.

"%~dp0KavoshDB.exe"

echo.
echo   ------------------------------------------------------------
echo   برنامه با کد %ERRORLEVEL% بسته شد.
if exist "%LOCALAPPDATA%\KavoshDB\logs\startup-error.log" (
  echo   گزارش خطا:
  echo   %LOCALAPPDATA%\KavoshDB\logs\startup-error.log
)
echo   ------------------------------------------------------------
echo.
pause
